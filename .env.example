# Server-only — used by lib/backend.ts (Server Components + app/api/*
# route handlers). Never prefix this NEXT_PUBLIC_, or the URL ships in the
# client bundle and defeats the point of routing through the BFF.
API_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_VERSION_KEY=port-landing
# Matches port-server's PROXY_SHARED_SECRET. Lets app/api/* route handlers
# forward the visitor's real IP for accurate view counting; leave unset in
# development if port-server's PROXY_SHARED_SECRET is also unset.
PROXY_SHARED_SECRET=
